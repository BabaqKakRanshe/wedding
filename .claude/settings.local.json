{
  "permissions": {
    "allow": [
      "Bash(git init *)",
      "Bash(python -m http.server 8765)",
      "Bash(curl -s -o NUL -w \"index: %{http_code}\\\\n\" http://localhost:8765/)",
      "Bash(curl -s -o NUL -w \"css/styles.css: %{http_code}\\\\n\" http://localhost:8765/assets/css/styles.css)",
      "Bash(curl -s -o NUL -w \"js/i18n.js: %{http_code}\\\\n\" http://localhost:8765/assets/js/i18n.js)",
      "Bash(curl -s -o NUL -w \"js/countdown.js: %{http_code}\\\\n\" http://localhost:8765/assets/js/countdown.js)",
      "Bash(curl -s -o NUL -w \"js/reveal.js: %{http_code}\\\\n\" http://localhost:8765/assets/js/reveal.js)",
      "Bash(python -c ' *)",
      "PowerShell($p = \\(Get-NetTCPConnection -LocalPort 8765 -ErrorAction SilentlyContinue\\).OwningProcess; if \\($p\\) { Stop-Process -Id $p -Force; \"Stopped $p\" } else { \"Not running\" })"
    ]
  }
}
